{
  "name": "@mylife/payments",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./compliance": "./src/compliance/index.ts",
    "./compliance/disclosures": "./src/compliance/disclosures/index.ts",
    "./ops": "./src/ops/index.ts",
    "./projections": "./src/projections/index.ts",
    "./providers": "./src/providers/index.ts",
    "./launch": "./src/launch/index.ts",
    "./risk": "./src/risk/index.ts",
    "./wallet": "./src/wallet/index.ts",
    "./ui": {

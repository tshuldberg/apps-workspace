      "uuid@7.0.3": "14.0.0",
      "uuid@9.0.1": "14.0.0",
      "uuid@11.1.0": "14.0.0",
      "ws@6.2.3": "6.2.4",
      "ws@8.19.0": "8.21.0",
      "brace-expansion@1.1.13": "1.1.18",
      "brace-expansion@5.0.6": "5.0.9",
      "fast-uri@3.1.2": "3.1.4",
      "js-yaml@4.2.0": "4.3.2",
      "shell-quote@1.8.4": "1.9.0",
      "tar@7.5.16": "7.5.19"
    }
  },
  "codeflash": {

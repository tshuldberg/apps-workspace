{
  "name": "mylife",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:mobile": "turbo dev --filter=@mylife/mobile",
    "dev:web": "turbo dev --filter=@mylife/web",
    "build": "turbo build",
    "benchmark:db": "node --experimental-default-type=module --experimental-strip-types scripts/benchmark-db.ts",
    "test": "turbo test --concurrency=1",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "check:standalone": "bash scripts/perf-audit/run-js.sh scripts/check-standalone-repos.mjs",
    "check:module-parity": "bash scripts/perf-audit/run-js.sh scripts/check-module-parity.mjs",
    "check:passthrough-parity": "pnpm --filter @mylife/web test:parity",
    "check:workouts-parity": "bash scripts/perf-audit/run-js.sh scripts/check-workouts-parity.mjs",
    "check:dowork-parity": "bash scripts/perf-audit/run-js.sh scripts/check-dowork-parity.mjs",
    "check:meerkat-parity": "bash scripts/perf-audit/run-js.sh scripts/check-meerkat-parity.mjs",
    "check:meerkat-transport-nc": "bash scripts/perf-audit/run-js.sh scripts/check-meerkat-transport-nc.mjs --self-test && bash scripts/perf-audit/run-js.sh scripts/check-meerkat-transport-nc.mjs",
    "test:meerkat-plan43-proof": "pnpm --filter @mylife/meerkat-relay exec vitest run src/__tests__/archive-intake-http.test.ts src/__tests__/archive-scanner-worker.test.ts src/__tests__/archive-pin-reconciler.test.ts src/__tests__/archive-takedown-propagator.test.ts src/__tests__/archive-lifecycle-store-conformance.test.ts src/__tests__/archive-announcement-scheduler.test.ts src/__tests__/archive-malware-clamd.test.ts src/__tests__/ncmec-filing-worker.test.ts src/__tests__/ncmec-filing-http-client.test.ts src/__tests__/operator-alerts.test.ts src/__tests__/community-history-announce.test.ts src/__tests__/community-history-announce-e2e.test.ts src/__tests__/community-node-e2e.test.ts && pnpm --filter @mylife/sync exec vitest run src/node/__tests__/community-history-sync.test.ts",
    "check:mynews-console-integrity": "bash scripts/mynews-console-integrity-check.sh",
    "check:mynews-parity": "bash scripts/perf-audit/run-js.sh scripts/check-mynews-parity.mjs",
    "check:mynews-env-matrix": "node scripts/gen-mynews-env-matrix.mjs --check",
    "check:module-layouts": "bash scripts/perf-audit/run-js.sh scripts/check-module-layout-consistency.mjs",
    "check:web-barrel": "bash scripts/perf-audit/run-js.sh scripts/check-web-ui-barrel-imports.mjs",
    "check:esm-require": "node scripts/check-esm-require.mjs",
    "check:generated-artifacts": "bash scripts/perf-audit/run-js.sh scripts/perf-audit/check-generated-artifacts.mjs",
    "check:no-ungated-fixtures": "node apps/bestchef/scripts/check-no-ungated-fixtures.mjs",
    "check:i18n-parity": "node apps/bestchef/scripts/check-i18n-parity.mjs",
    "check:i18n-values": "node apps/bestchef/scripts/check-i18n-values.mjs",
    "check:raw-strings": "node apps/bestchef/scripts/check-raw-strings.mjs",
    "check:rtl-icons": "node apps/bestchef/scripts/check-rtl-icons.mjs",
    "check:compliance-keys": "node apps/bestchef/scripts/gen-compliance-keys.mjs --check",
    "check:store-metadata": "node apps/bestchef/scripts/check-store-metadata.mjs",
    "check:parity": "pnpm check:esm-require && pnpm check:standalone && pnpm check:module-parity && pnpm check:passthrough-parity && pnpm check:workouts-parity && pnpm check:dowork-parity && pnpm check:meerkat-parity && pnpm check:meerkat-transport-nc && pnpm check:mynews-parity && pnpm check:module-layouts && pnpm check:no-ungated-fixtures && pnpm check:i18n-parity && pnpm check:i18n-values && pnpm check:raw-strings && pnpm check:rtl-icons && pnpm check:compliance-keys && pnpm check:store-metadata",
    "audit:functions": "bash scripts/perf-audit/run-js.sh scripts/perf-audit/generate-function-performance-report.mjs",
    "scaffold:function-test": "bash scripts/perf-audit/run-js.sh scripts/perf-audit/scaffold-function-quality-test.mjs",
    "gate:function": "bash scripts/perf-audit/run-js.sh scripts/perf-audit/run-function-quality-gate.mjs",
    "gate:function:changed": "bash scripts/perf-audit/run-js.sh scripts/perf-audit/run-changed-function-quality-gate.mjs",
    "eas:preflight": "bash scripts/eas-preflight.sh",
    "audit:deps": "pnpm audit --audit-level=high",
    "clean": "turbo clean",
    "test:coverage": "turbo test:coverage",
    "test:coverage:ci": "turbo test:coverage --concurrency=1 --filter=!@mylife/bestchef --filter=!@mylife/books --filter=!@mylife/budget --filter=!@mylife/car --filter=!@mylife/habits --filter=!@mylife/mobile --filter=!@mylife/nutrition --filter=!@mylife/web",
    "test:parity-matrix": "pnpm --filter @mylife/web test:parity",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@vitest/coverage-v8": "3.2.6",
    "eslint": "^8.57.1",
    "fast-check": "^4.6.0",
    "husky": "^9.1.7",
    "playwright": "1.58.2",
    "turbo": "2.9.18",
    "typescript": "^5.7.0",
    "vitest": "3.2.6"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {

      "@istanbuljs/load-nyc-config>js-yaml": "4.3.2",
      "minimatch@3.1.3": "3.1.4",
      "minimatch@9.0.6": "9.0.7",
      "next": "15.5.21",
      "nanoid@3.3.16": "3.3.18",
      "node-forge@1.3.3": "1.4.0",
      "picomatch@2.3.1": "2.3.2",
      "picomatch@3.0.1": "3.0.2",

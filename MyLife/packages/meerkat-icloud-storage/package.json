{
  "name": "@mylife/meerkat-icloud-storage",
  "version": "0.1.0",
  "private": true,
  "description": "Owned Expo native module for Meerkat iCloud Drive storage and iOS security-scoped file-provider bookmarks.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",

{
  "extends": "@mylife/typescript-config/base.json",
  "compilerOptions": {
    "outDir": "./dist",
    // Package root (not ./src) so a src test may import the sibling host/* source
    // (e.g. host-adopt-e2e.test.ts -> host/host-config buildHostConnectionCard)
    // without TS6059. include stays ["src"], so host/__tests__ is still not typechecked.
    "rootDir": ".",
    "lib": ["ES2022"],
    "types": ["node"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src", "host"],
  "exclude": ["node_modules", "dist"]
}

{
  "name": "@mylife/meerkat-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "meerkat-relay": "./bin/meerkat-relay.mjs",
    "meerkat-direct": "./bin/meerkat-direct.mjs",
    "meerkat-node": "./bin/meerkat-node.mjs",
    "meerkat-community-node": "./bin/meerkat-community-node.mjs",
    "meerkat-public-directory-node": "./bin/meerkat-public-directory-node.mjs",
    "meerkat-verification-service": "./bin/meerkat-verification-service.mjs",
    "meerkat-persona-service": "./bin/meerkat-persona-service.mjs",
    "meerkat-hosted-service": "./bin/meerkat-hosted-service.mjs",
    "meerkat-postgres-migrate": "./bin/meerkat-postgres-migrate.mjs",
    "meerkat-postgres-role-grants": "./bin/meerkat-postgres-role-grants.mjs",
    "meerkat-postgres-state-import": "./bin/meerkat-postgres-state-import.mjs",
    "meerkat-postgres-cutover": "./bin/meerkat-postgres-cutover.mjs",
    "meerkat-host": "./bin/meerkat-host.mjs"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src bin --ext .ts,.mjs",
    "test": "vitest run",
    "test:postgres": "vitest run --no-file-parallelism src/postgres/__tests__/*integration.test.ts src/postgres/stores/__tests__/*integration.test.ts src/state-import/__tests__/*integration.test.ts",
    "test:s3": "vitest run --no-file-parallelism src/__tests__/object-store-s3.integration.test.ts",
    "test:s3-hosted": "vitest run --no-file-parallelism src/__tests__/hosted-object-store-ingest.integration.test.ts",
    "test:s3-archive": "vitest run --no-file-parallelism src/__tests__/archive-object-bytes.integration.test.ts",
    "test:watch": "vitest",
    "start": "tsx bin/meerkat-relay-server.mjs",
    "start:full": "tsx bin/meerkat-relay.mjs",
    "start:community-node": "tsx bin/meerkat-community-node.mjs",
    "start:public-directory-node": "tsx bin/meerkat-public-directory-node.mjs",
    "start:verification-service": "tsx bin/meerkat-verification-service.mjs",
    "start:persona-service": "tsx bin/meerkat-persona-service.mjs",
    "start:account-service": "tsx bin/meerkat-account-service.mjs",
    "start:hosted-service": "tsx bin/meerkat-hosted-service.mjs",
    "start:archive-scanner": "tsx bin/meerkat-archive-scanner.mjs",
    "start:archive-seeder": "tsx bin/meerkat-archive-seeder.mjs",
    "start:ncmec-filing-worker": "tsx bin/meerkat-ncmec-filing-worker.mjs",
    "migrate:postgres": "node bin/meerkat-postgres-migrate.mjs",
    "postgres:role-grants": "node bin/meerkat-postgres-role-grants.mjs",
    "state-import:postgres": "node bin/meerkat-postgres-state-import.mjs",
    "cutover:postgres": "node bin/meerkat-postgres-cutover.mjs",
    "backup:postgres": "node bin/meerkat-postgres-backup.mjs",
    "release:postgres": "node bin/meerkat-release.mjs",
    "promotion:postgres": "node bin/meerkat-promotion.mjs",
    "rehearsal:postgres": "node bin/meerkat-rehearsal.mjs",
    "start:host": "tsx bin/meerkat-host.mjs",
    "smoke": "node scripts/smoke-relay.mjs",
    "load:relay": "node scripts/load/load-relay.mjs",
    "soak:run": "node scripts/soak/soak-runner.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@mylife/billing-config": "workspace:*",
    "@mylife/entitlements": "workspace:*",
    "@mylife/sync": "workspace:*",
    "livekit-server-sdk": "2.17.0",
    "pg": "^8.22.0",
    "tsx": "^4.19.2",
    "tweetnacl": "^1.0.3",
    "ws": "8.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mylife/db": "workspace:*",
    "@mylife/module-registry": "workspace:*",
    "@mylife/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.5.12",
    "tweetnacl-util": "^0.15.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}

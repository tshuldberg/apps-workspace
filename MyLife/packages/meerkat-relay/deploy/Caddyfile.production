{
  email {$ACME_EMAIL}
  admin off
}

{$RELAY_DOMAIN} {
  reverse_proxy relay:8787
}

{$HUMANITY_DOMAIN} {
  reverse_proxy humanity:8892
}

{$HOSTED_DOMAIN} {
  reverse_proxy hosted:8893
}

{$PERSONA_DOMAIN} {
  reverse_proxy persona:8894
}

{$COMMUNITY_DOMAIN} {
  reverse_proxy community:8890
}

{$DIRECTORY_DOMAIN} {
  reverse_proxy directory:8891
}

{$MODERATION_DOMAIN} {
  @moderation_allowed remote_ip {$MODERATION_ALLOWED_CIDRS}
  handle @moderation_allowed {
    reverse_proxy community:8891
  }
  respond "Restricted operator network" 403
}

# Plan 51: verification-account service (SSO sign-in, entitlement webhooks, blind
# credential issuance). Public TLS like the other first-party services; the wall
# lives in the service's role grants and redaction, not in network placement.
{$ACCOUNT_DOMAIN} {
  reverse_proxy account:8896
}

# Plan 25 WP-25I: LiveKit room signaling over TLS WebSocket. Media (SRTP) uses the
# RTC UDP/TCP ports published directly by the livekit service, not this proxy.
{$LIVEKIT_DOMAIN} {
  reverse_proxy livekit:7880
}

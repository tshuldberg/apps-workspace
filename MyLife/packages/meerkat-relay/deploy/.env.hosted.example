# Meerkat HOSTED BILLING SERVICE env (Plan 22 Phase 2).
# All secrets are env-only and never ship to a client bundle. The service refuses to
# boot (fail closed) unless every REQUIRED value below is set.

# --- server ---
PORT=8893
HOST=0.0.0.0
# Durable volume: billing store (subscriptions/, purchases/, links/) + per-tenant
# opaque seeder stores (tenants/).
DATA_DIR=/data

# --- REQUIRED: entitlements + webhook ---
# HMAC secret used to sign short-lived hosted entitlement tokens the relay verifies.
ENTITLEMENT_SECRET=
# Stripe webhook signing secret (whsec_...). Verifies every /api/billing/webhook call.
WEBHOOK_SECRET=

# --- REQUIRED: Stripe ---
STRIPE_SECRET_KEY=sk_live_or_test_...
# Price id for the $4.99/mo hosted subscription (founder-locked price; storage included).
STRIPE_MONTHLY_PRICE_ID=price_...
# Price id for the $4.99 one-time app unlock.
STRIPE_APP_UNLOCK_PRICE_ID=price_...

# --- OPTIONAL: cross-rail store-receipt validation (founder-ops, Tier-D) ---
# Until App Store Server API / Google Play Developer API credentials are wired into
# the bin, store-receipt linking is fail-closed (unavailable) and the app says so. A
# web (Stripe) purchase can still mint a Link code because its row already exists.

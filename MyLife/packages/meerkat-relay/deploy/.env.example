# Meerkat relay environment.
#
# The relay is zero-knowledge: it reads ONLY the two variables below. It takes no
# API keys, no database credentials, no signing keys, and no decryption keys.
# There is nothing secret to leak from the relay process. The only
# secret-adjacent surface in the whole deployment is the TLS certificate, and
# that lives at the edge proxy (Caddy / Fly / Render), never here.

# Port the relay listens on (WebSocket + GET /healthz share this port).
PORT=8787

# Interface to bind. 0.0.0.0 inside a container behind a trusted edge proxy.
HOST=0.0.0.0

# --- edge proxy only (NOT read by the relay) ---
# Used by deploy/Caddyfile if you run the optional caddy TLS edge in
# docker-compose. The relay never sees this.
# RELAY_DOMAIN=relay-us.example.com

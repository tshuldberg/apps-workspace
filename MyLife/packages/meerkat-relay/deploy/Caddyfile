# TLS edge for the Meerkat relay.
#
# Caddy terminates wss and auto-provisions a Let's Encrypt certificate for
# {$RELAY_DOMAIN}, then reverse-proxies BOTH the WebSocket upgrade and the plain
# GET /healthz probe to the relay container on port 8787. The relay speaks plain
# ws and never sees the certificate: TLS is owned entirely by this edge.
#
# reverse_proxy forwards the X-Forwarded-For header. Set
# MEERKAT_TRUST_PROXY_HOPS=1 on the relay only when this Caddy instance is the
# sole controlled proxy hop, so per-client caps use the address immediately to
# its left. Without that explicit setting, the relay safely ignores the header.

{$RELAY_DOMAIN} {
	# WebSocket upgrades and /healthz both proxy to the same relay port. Caddy
	# transparently upgrades the connection when the client sends Upgrade: websocket.
	reverse_proxy relay:8787 {
		header_up X-Forwarded-For {remote_host}
	}

	# Access logs are at the EDGE and see only request lines, never the opaque
	# ws frames carried inside an established connection. Keep them request-only.
	log {
		output stdout
		format console
	}
}

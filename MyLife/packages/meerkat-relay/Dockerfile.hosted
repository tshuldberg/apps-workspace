# Meerkat HOSTED BILLING SERVICE image (Plan 22 Phase 2) -- a SEPARATE deployable.
#
# UNLIKE the slim relay image (Dockerfile), this service needs @mylife/sync at runtime
# (per-tenant seeder stores + Ed25519 device-signed auth) AND a DATA_DIR volume for the
# durable billing store (subscriptions + app purchases + single-use link codes), so it
# is a SEPARATE image and MUST be built from the MONOREPO ROOT as context so pnpm can
# resolve the workspace:
#
#   docker build -f packages/meerkat-relay/Dockerfile.hosted -t meerkat-hosted .
#
# It runs the TS entry directly via tsx (the bin's documented run form), resolving
# @mylife/* through the workspace. Pruning this to a minimal compiled production image
# is deferred ops; this is the runnable reference image.
#
# Base pinned by manifest-list digest for supply-chain reproducibility; the
# comment records the human-readable tag (node:22-alpine).
FROM node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS runtime
WORKDIR /repo
RUN npm i -g pnpm@9 tsx
# Monorepo context: copy the whole workspace so pnpm can resolve @mylife/* workspace deps.
COPY . .
# Install only what the relay package (and its @mylife/* workspace deps) need.
RUN pnpm install --frozen-lockfile --filter @mylife/meerkat-relay...

WORKDIR /repo/packages/meerkat-relay
ENV NODE_ENV=production
ENV PORT=8893
ENV HOST=0.0.0.0
# The DATA_DIR volume holds the DURABLE billing store (subscriptions/, purchases/,
# links/) plus per-tenant opaque seeder stores (tenants/). ENTITLEMENT_SECRET,
# WEBHOOK_SECRET, STRIPE_SECRET_KEY, STRIPE_MONTHLY_PRICE_ID, and
# STRIPE_APP_UNLOCK_PRICE_ID are required at runtime; the service refuses to start
# otherwise (fail closed). Secrets are env-only and never ship to a client bundle.
ENV DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 8893
# Container-level liveness: the service's own bounded GET /healthz (no billing fields).
HEALTHCHECK --interval=15s --timeout=5s --start-period=8s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8893)+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
USER node
CMD ["tsx", "bin/meerkat-hosted-service.mjs"]

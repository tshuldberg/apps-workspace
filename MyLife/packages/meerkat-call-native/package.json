{
  "name": "@mylife/meerkat-call-native",
  "version": "0.1.0",
  "private": true,
  "description": "Owned Expo native module for Meerkat's iOS PushKit and CallKit plus Android Core Telecom call surfaces. Contains no identity, media, or signaling logic and stays honestly unavailable when the native module is absent.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "react-native": "./src/index.ts",
  "sideEffects": false,
  "expo": {
    "platforms": ["ios", "android"]
  },
  "files": [
    "src",
    "ios",
    "android",
    "app.plugin.js",
    "expo-module.config.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "expo": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo": { "optional": true },
    "react-native": { "optional": true }
  },
  "devDependencies": {
    "@mylife/typescript-config": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}

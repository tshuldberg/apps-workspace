    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@mylife/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.28",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^8.57.1",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }

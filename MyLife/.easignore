# Monorepo EAS archive ignore for standalone app builds.
# Keep workspace packages/modules available for pnpm workspace resolution, but
# exclude local caches, VCS metadata, generated output, and unrelated app shells.

.git/
.github/
.claude/
.context/
.gstack/
.kiro/
.playwright-mcp/
.turbo/
.vscode/

node_modules/
**/node_modules/

# App local/generated output.
apps/bestchef/dist/
apps/bestchef/.expo/
apps/bestchef/ios/Pods/
apps/bestchef/ios/build/
apps/bestchef/android/
apps/bestchef/*.tsbuildinfo
apps/mobile/dist/
apps/mobile/.expo/
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/*.tsbuildinfo
apps/web/.next/
apps/web/coverage/
apps/web/test-results/
apps/web/*.db
apps/web/*.db-shm
apps/web/*.db-wal
apps/web/*.tsbuildinfo

# Repository docs, archives, and generated artifacts not needed remotely.
archive/
artifacts/
deploy/
docs/
output/
plans/
supabase/
test/
tmp/

# Tests and reports.
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
coverage/
test-results/
*.pnpm-debug.log

# Local secrets.
.env
.env.*
*.key
*.pem
*.p8
*.p12
*.mobileprovision
GoogleService-Info.plist
google-services.json
*.keystore
*.jks
.npmrc
/secrets/
/credentials/

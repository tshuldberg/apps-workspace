<script type="importmap">
{
  "imports": {
    "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
    "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
  }
}
</script>
<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

const canvas = document.getElementById('world');
const tip = document.getElementById('world-tip');
const zoomReadout = document.getElementById('zoom-readout');

// ----------------------------------------------------------------
// Constants
// ----------------------------------------------------------------
const EARTH_R = 10;
const HUB_ORBIT_R = 17;          // privileged hub orbiting altitude
const ARC_ALT = 1.8;             // how far above surface arcs bulge
const NODE_ALT = 0.06;           // tiny float so nodes sit just above surface
const RING_ALT = 0.04;
const CAM_FAR = 40;              // initial camera distance
const CAM_MIN = 11.6;            // min orbit distance (don't penetrate sphere)
const CAM_MAX = 70;
const ZOOM_EXPAND_START = 22;    // begin expanding clusters when closer than this
const ZOOM_EXPAND_END   = 14;    // fully expanded by this distance

// ----------------------------------------------------------------
// Scene / camera / renderer
// ----------------------------------------------------------------
const scene = new THREE.Scene();
scene.background = new THREE.Color(0x05060B);

const camera = new THREE.PerspectiveCamera(45, canvas.clientWidth / canvas.clientHeight, 0.1, 2000);
camera.position.set(0, 6, CAM_FAR);

const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
function resize() {
  const w = canvas.clientWidth, h = canvas.clientHeight;
  renderer.setSize(w, h, false);
  camera.aspect = w / h;
  camera.updateProjectionMatrix();
}
resize();
new ResizeObserver(resize).observe(canvas);

const controls = new OrbitControls(camera, renderer.domElement);
controls.enableDamping = true;
controls.dampingFactor = 0.06;
controls.minDistance = 14;
controls.maxDistance = 80;
controls.autoRotate = true;
controls.autoRotateSpeed = 0.45;

// Lights
scene.add(new THREE.AmbientLight(0x556677, 0.55));
const key = new THREE.DirectionalLight(0xFFCFA0, 0.9);
key.position.set(10, 18, 12);
scene.add(key);
const rim = new THREE.PointLight(0x86EFAC, 1.2, 80);
rim.position.set(-12, -6, -10);
scene.add(rim);
const cool = new THREE.PointLight(0x8BCFF0, 0.8, 80);
cool.position.set(14, 4, -16);
scene.add(cool);

// Starfield
{
  const g = new THREE.BufferGeometry();
  const count = 700;
  const pos = new Float32Array(count * 3);
  for (let i = 0; i < count; i++) {
    const r = 60 + Math.random() * 40;
    const t = Math.random() * Math.PI * 2;
    const p = Math.acos(2 * Math.random() - 1);
    pos[i*3]   = r * Math.sin(p) * Math.cos(t);
    pos[i*3+1] = r * Math.sin(p) * Math.sin(t) * 0.6;
    pos[i*3+2] = r * Math.cos(p);
  }
  g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
  const m = new THREE.PointsMaterial({ size: 0.12, color: 0xffffff, transparent: true, opacity: 0.45 });
  scene.add(new THREE.Points(g, m));
}

// Network spec
const colors = {
  personal: 0xFFB877,
  group:    0xA78BFA,
  community:0xF472B6,
  hub:      0x2DD4BF
};

const workspaces = [
  { id:'personal-A', kind:'personal', label:"Avery's personal ring", radius:5,  center:new THREE.Vector3(-12, 1, 6),  members:[
      {name:"iPhone",  desc:"All modules · personal_replica scope. Drafts stay device_local."},
      {name:"iPad",    desc:"Selective sync. Receipt OCR raw blobs never leave this device."},
      {name:"Mac",     desc:"Web shell. Mirrors personal_replica."},
      {name:"Pixel 8", desc:"Cross-vendor peer; ranked-choice picks LAN first."}
  ]},
  { id:'personal-B', kind:'personal', label:"Sam's personal ring", radius:4.6, center:new THREE.Vector3(11, 0.5, 7), members:[
      {name:"iPhone",  desc:"Full hub · 30 modules wired locally."},
      {name:"Mac",     desc:"Web companion."},
      {name:"Watch",   desc:"BLE wake-up only. Never carries content payloads."}
  ]},
  { id:'personal-C', kind:'personal', label:"Jordan's personal ring", radius:4.2, center:new THREE.Vector3(13, -0.5, -10), members:[
      {name:"Pixel 8", desc:"Personal."},
      {name:"Tablet",  desc:"Read-mostly."}
  ]},
  { id:'group-1',    kind:'group',    label:"Family · group workspace", radius:6,   center:new THREE.Vector3(-3, -1, -3), members:[
      {name:"Avery iPhone",   desc:"Member of Family. Budget envelopes shared in shared_workspace scope."},
      {name:"Sam iPhone",     desc:"Member."},
      {name:"Family iPad",    desc:"Common device."},
      {name:"HomeBase Mac",   desc:"Receives encrypted bilateral sync."}
  ]},
  { id:'community-1',kind:'community',label:"Cycling · community workspace", radius:7.5, center:new THREE.Vector3(-15, 1.5, -10), members:[
      {name:"Member 1", desc:"Cycle data shared at maxScope = shared_workspace; sensitive overlays cap below."},
      {name:"Member 2", desc:"Anon-handle visible to peers; device pubkey not exposed."},
      {name:"Member 3", desc:"Receives encrypted offers; replies bilateral."},
      {name:"Member 4", desc:"Joins via fingerprint-compare pairing."},
      {name:"Member 5", desc:"Drops back to BLE when LAN unavailable."}
  ]}
];

const ringGroup = new THREE.Group();
const deviceGroup = new THREE.Group();
const linkGroup = new THREE.Group();
const flowGroup = new THREE.Group();
scene.add(ringGroup, deviceGroup, linkGroup, flowGroup);

// Ring meshes
function makeRing(r, color, opacity){
  const g = new THREE.RingGeometry(r-0.05, r+0.05, 96);
  const m = new THREE.MeshBasicMaterial({ color, side: THREE.DoubleSide, transparent:true, opacity });
  const mesh = new THREE.Mesh(g, m);
  mesh.rotation.x = -Math.PI/2;
  return mesh;
}

const allDevices = []; // for picking
const allLinks = [];

workspaces.forEach(ws => {
  const color = colors[ws.kind];
  const ring = makeRing(ws.radius, color, 0.45);
  ring.position.copy(ws.center);
  ring.userData = { kind:'workspace', ws };
  ringGroup.add(ring);

  // soft halo
  const halo = makeRing(ws.radius * 1.04, color, 0.12);
  halo.position.copy(ws.center);
  ringGroup.add(halo);

  // label disc (sprite) — tiny CSS-less label is hard, so we draw a glow disc
  const discGeom = new THREE.CircleGeometry(ws.radius * 0.96, 64);
  const discMat = new THREE.MeshBasicMaterial({ color, transparent:true, opacity:0.04 });
  const disc = new THREE.Mesh(discGeom, discMat);
  disc.rotation.x = -Math.PI/2;
  disc.position.copy(ws.center);
  disc.position.y -= 0.02;
  ringGroup.add(disc);

  // devices distributed around ring
  ws.members.forEach((m, i) => {
    const t = (i / ws.members.length) * Math.PI * 2 + (ws.kind === 'community' ? 0.2 : 0);
    const p = new THREE.Vector3(
      ws.center.x + Math.cos(t) * ws.radius,
      ws.center.y + (Math.sin(t*1.4) * 0.5),
      ws.center.z + Math.sin(t) * ws.radius
    );
    const sphereGeom = new THREE.IcosahedronGeometry(0.55, 1);
    const sphereMat = new THREE.MeshStandardMaterial({
      color, emissive: color, emissiveIntensity: 0.45,
      roughness: 0.4, metalness: 0.2
    });
    const dev = new THREE.Mesh(sphereGeom, sphereMat);
    dev.position.copy(p);
    dev.userData = { kind:'device', ws, member:m, basePos: p.clone(), phase: Math.random() * Math.PI * 2 };
    deviceGroup.add(dev);
    allDevices.push(dev);
  });
});

// Privileged hub at origin
const hubGroup = new THREE.Group();
{
  const core = new THREE.Mesh(
    new THREE.IcosahedronGeometry(1.6, 2),
    new THREE.MeshStandardMaterial({ color: colors.hub, emissive: colors.hub, emissiveIntensity: 0.7, roughness: 0.25, metalness: 0.4 })
  );
  core.userData = { kind:'hub', label:'Privileged hub (opt-in)', desc:'Optional cloud replica. Stores ciphertext blobs addressed by ephemeral tokens. Server cannot read content.' };
  hubGroup.add(core);
  allDevices.push(core);

  // shells
  for (let i = 0; i < 3; i++){
    const shell = new THREE.Mesh(
      new THREE.IcosahedronGeometry(2 + i*0.5, 1),
      new THREE.MeshBasicMaterial({ color: colors.hub, transparent:true, opacity: 0.06, wireframe:true })
    );
    shell.userData.spin = 0.002 + i*0.0015;
    hubGroup.add(shell);
  }
}
scene.add(hubGroup);

// Links — within each workspace pairs, plus opt-in hub links from one device per workspace
function makeLink(a, b, color, opacity){
  const points = [a.clone(), b.clone()];
  const g = new THREE.BufferGeometry().setFromPoints(points);
  const m = new THREE.LineBasicMaterial({ color, transparent: true, opacity });
  const line = new THREE.Line(g, m);
  return line;
}

// Within-ring connections
{
  const byWs = {};
  allDevices.forEach(d => {
    if (d.userData.kind !== 'device') return;
    const id = d.userData.ws.id;
    (byWs[id] = byWs[id] || []).push(d);
  });
  Object.values(byWs).forEach(devs => {
    const ws = devs[0].userData.ws;
    const color = colors[ws.kind];
    devs.forEach((a,i) => {
      devs.forEach((b,j) => {
        if (j <= i) return;
        const l = makeLink(a.position, b.position, color, 0.22);
        linkGroup.add(l);
        allLinks.push({ line: l, a, b, color });
      });
    });
  });
}

// Hub links (opt-in) — one device per ring connects to hub
workspaces.forEach(ws => {
  const dev = allDevices.find(d => d.userData.kind === 'device' && d.userData.ws.id === ws.id);
  if (!dev) return;
  const l = makeLink(dev.position, hubGroup.position, colors.hub, 0.28);
  l.material.transparent = true;
  linkGroup.add(l);
  allLinks.push({ line: l, a: dev, b: hubGroup, color: colors.hub, hub:true });
});

// Animated data-flow particles along links
const flowParticles = [];
function spawnParticles(){
  flowGroup.clear();
  flowParticles.length = 0;
  allLinks.forEach(link => {
    const count = link.hub ? 4 : 2;
    for (let k = 0; k < count; k++){
      const g = new THREE.SphereGeometry(0.08, 8, 8);
      const m = new THREE.MeshBasicMaterial({ color: link.color, transparent:true, opacity:0.95 });
      const p = new THREE.Mesh(g, m);
      flowGroup.add(p);
      flowParticles.push({ mesh: p, link, t: Math.random(), speed: 0.0015 + Math.random()*0.0025 });
    }
  });
}
spawnParticles();

// Picking
const ray = new THREE.Raycaster();
const pointer = new THREE.Vector2();
let hovered = null;

canvas.addEventListener('pointermove', (e) => {
  const rect = canvas.getBoundingClientRect();
  pointer.x = ((e.clientX - rect.left) / rect.width) * 2 - 1;
  pointer.y = -((e.clientY - rect.top) / rect.height) * 2 + 1;
  ray.setFromCamera(pointer, camera);
  const hits = ray.intersectObjects(allDevices, false);
  if (hits.length){
    const obj = hits[0].object;
    if (hovered !== obj){
      hovered = obj;
      const u = obj.userData;
      let html = '';
      if (u.kind === 'device'){
        const ws = u.ws;
        html = `<strong>${u.member.name}</strong>
          <span class="sub">${ws.label} · scope: ${ws.kind === 'personal' ? 'personal_replica' : ws.kind === 'group' ? 'shared_workspace' : 'shared_workspace (community)'}</span>
          <span class="sub" style="color:#E4E1E9;margin-top:6px;display:block">${u.member.desc}</span>`;
      } else if (u.kind === 'hub'){
        html = `<strong style="color:#9EEEDF">${u.label}</strong>
          <span class="sub">${u.desc}</span>`;
      }
      tip.innerHTML = html;
      tip.style.display = 'block';
    }
    tip.style.left = (e.clientX - rect.left + 14) + 'px';
    tip.style.top  = (e.clientY - rect.top + 14) + 'px';
  } else {
    hovered = null;
    tip.style.display = 'none';
  }
});

canvas.addEventListener('pointerleave', () => { tip.style.display = 'none'; });

// Buttons
const btnRotate = document.getElementById('btn-rotate');
const btnFlow   = document.getElementById('btn-flow');
const btnExplode= document.getElementById('btn-explode');

btnRotate.addEventListener('click', () => {
  controls.autoRotate = !controls.autoRotate;
  btnRotate.classList.toggle('active', controls.autoRotate);
});

let flowOn = true;
btnFlow.addEventListener('click', () => {
  flowOn = !flowOn;
  flowGroup.visible = flowOn;
  btnFlow.classList.toggle('active', flowOn);
});
btnFlow.classList.toggle('active', flowOn);

let exploded = false;
btnExplode.addEventListener('click', () => {
  exploded = !exploded;
  btnExplode.classList.toggle('active', exploded);
});

// Animate
function animate(t){
  const time = t * 0.001;

  // Hub spin
  hubGroup.rotation.y += 0.004;
  hubGroup.children.forEach(c => { if (c.userData.spin) c.rotation.y += c.userData.spin; });

  // Devices: gentle bob + explode offset
  allDevices.forEach(d => {
    if (d.userData.kind !== 'device') return;
    const u = d.userData;
    const bob = Math.sin(time * 0.8 + u.phase) * 0.18;
    const explodeFactor = exploded ? 2.4 : 1.0;
    const dir = u.basePos.clone().sub(u.ws.center).normalize();
    const r = u.basePos.distanceTo(u.ws.center) * (exploded ? 1.6 : 1.0);
    const cy = u.ws.center.y + bob + (exploded ? dir.y * 1.6 : 0);
    d.position.set(
      u.ws.center.x + dir.x * r,
      cy,
      u.ws.center.z + dir.z * r
    );
  });

  // Update link geometry (since devices moved)
  allLinks.forEach(link => {
    const aPos = link.a.position;
    const bPos = link.b.position ? link.b.position : link.b.getWorldPosition(new THREE.Vector3());
    const arr = link.line.geometry.attributes.position.array;
    arr[0] = aPos.x; arr[1] = aPos.y; arr[2] = aPos.z;
    arr[3] = bPos.x; arr[4] = bPos.y; arr[5] = bPos.z;
    link.line.geometry.attributes.position.needsUpdate = true;
  });

  // Move flow particles along links
  if (flowOn) flowParticles.forEach(p => {
    p.t += p.speed;
    if (p.t > 1) p.t = 0;
    const aPos = p.link.a.position;
    const bPos = p.link.b.position || p.link.b.getWorldPosition(new THREE.Vector3());
    p.mesh.position.lerpVectors(aPos, bPos, p.t);
    const pulse = 0.6 + Math.sin(time * 2 + p.t * 6) * 0.4;
    p.mesh.material.opacity = pulse;
  });

  controls.update();
  renderer.render(scene, camera);
  requestAnimationFrame(animate);
}
requestAnimationFrame(animate);

// ============================================================
// Module inventory population
// ============================================================
const modules = [
  ['books','📚','bk_','free'],['budget','💸','bg_','premium'],['car','🚗','cr_','premium'],
  ['closet','👔','cl_','premium'],['cycle','🌙','cy_','premium'],['dining','🍽','dn_','premium'],
  ['fast','⏱','ft_','free'],['flash','⚡','fl_','premium'],['forums','💬','fr_','premium'],
  ['garden','🌱','gd_','premium'],['habits','✅','hb_','premium'],['health','❤️','hl_','premium'],
  ['homes','🏠','hm_','premium'],['journal','📓','jr_','free'],['mail','✉️','ml_','premium'],
  ['market','🛒','mk_','premium'],['meds','💊','md_','premium'],['mood','😊','mo_','free'],
  ['notes','📝','nt_','free'],['nutrition','🥗','nu_','premium'],['pets','🐾','pe_','premium'],
  ['presence','📍','pr_','premium'],['recipes','🍳','rc_','premium','bestchef'],
  ['rsvp','📅','rv_','premium'],['stars','⭐','st_','premium'],['subs','🧾','sb_','premium'],
  ['surf','🌊','sf_','premium'],['trails','🥾','tr_','premium'],['voice','🎙','vo_','free'],
  ['words','🔤','wd_','free'],['workouts','💪','wk_','premium'],
  ['friends','👥','fn_','premium'],['classes','🎓','cs_','premium'],['create','🎨','ce_','premium'],
  ['music','🎵','mu_','premium'],['gaming','🎮','gm_','premium'],['shop','🛍','sh_','premium'],
  ['sleep','💤','sl_','hidden'],['pay','💳','py_','hidden']
];

const list = document.getElementById('modList');
modules.forEach(([name, icon, prefix, tier, spotlight]) => {
  const el = document.createElement('div');
  el.className = 'mod';
  el.dataset.tier = tier;
  if (spotlight) el.dataset.spotlight = spotlight;
  el.dataset.tip = `${name} · ${prefix} · ${tier}${spotlight === 'bestchef' ? ' · BestChef parent module' : ''}`;
  el.innerHTML = `<span class="icon">${icon}</span><span class="name">${name}</span><span class="pf">${prefix}</span>`;
  list.appendChild(el);
});
</script>

</body>
</html>

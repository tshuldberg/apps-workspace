        <text x="16" y="36" fill="rgba(255,255,255,0.45)" font-size="11">SwiftUI native shell (planned)</text>
      </g>

      <!-- Layer: Module Registry -->
      <rect x="40" y="150" width="1200" height="68" rx="14" fill="url(#lg-mod)" stroke="rgba(139,207,240,0.4)"/>
      <text x="60" y="178" fill="#BFE5F5" font-size="11" font-weight="700" letter-spacing="2">MODULE REGISTRY</text>
      <g transform="translate(280,160)">
        <rect width="940" height="44" rx="10" fill="rgba(139,207,240,0.10)" stroke="rgba(139,207,240,0.45)"/>

          <stop offset="0%" stop-color="#8BCFF0" stop-opacity="0.20"/>
          <stop offset="100%" stop-color="#8BCFF0" stop-opacity="0.04"/>
        </linearGradient>
        <linearGradient id="lg-pkg" x1="0" x2="1" y1="0" y2="1">
          <stop offset="0%" stop-color="#A78BFA" stop-opacity="0.18"/>
          <stop offset="100%" stop-color="#A78BFA" stop-opacity="0.04"/>
        </linearGradient>
        <linearGradient id="lg-data" x1="0" x2="1" y1="0" y2="1">
          <stop offset="0%" stop-color="#2DD4BF" stop-opacity="0.18"/>
          <stop offset="100%" stop-color="#2DD4BF" stop-opacity="0.04"/>
        </linearGradient>
        <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill="rgba(255,255,255,0.45)"/>
        </marker>
      </defs>

      <!-- Layer: Apps -->

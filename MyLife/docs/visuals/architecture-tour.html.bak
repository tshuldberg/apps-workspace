<!-- BESTCHEF ARCHITECTURE -->
<!-- ============================================================ -->
<section id="bestchef-arch">
  <h2><span class="num">04</span>BestChef — Standard Server Architecture</h2>
  <p class="sub">For BestChef's <strong>public launch</strong>, the launch-critical data path is a conventional cloud stack: Supabase Auth, Postgres with row-level security, Storage for media, and Edge Functions for moderation, ranking, leaderboards, and account-deletion workers. <strong>Local SQLite is an offline cache, draft store, and optimistic UI layer only — never the source of truth for public state.</strong> Mesh sync, BLE, and WebRTC are explicitly <em>not</em> on the launch-critical path.</p>

  <div class="diagram">
    <svg viewBox="0 0 1280 700" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="BestChef server architecture">
      <defs>
        <linearGradient id="bc-client" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#22C55E" stop-opacity="0.18"/>
          <stop offset="100%" stop-color="#22C55E" stop-opacity="0.03"/>
        </linearGradient>
        <linearGradient id="bc-edge" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#A78BFA" stop-opacity="0.18"/>
          <stop offset="100%" stop-color="#A78BFA" stop-opacity="0.03"/>
        </linearGradient>
        <linearGradient id="bc-data" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#8BCFF0" stop-opacity="0.18"/>
          <stop offset="100%" stop-color="#8BCFF0" stop-opacity="0.03"/>
        </linearGradient>
        <marker id="ar2" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
          <path d="M0,0 L10,5 L0,10 z" fill="rgba(255,255,255,0.55)"/>
        </marker>
      </defs>

      <!-- Clients -->
      <rect x="20" y="20" width="1240" height="150" rx="14" fill="url(#bc-client)" stroke="rgba(34,197,94,0.4)"/>
      <text x="40" y="46" fill="#86EFAC" font-size="11" font-weight="700" letter-spacing="2">CLIENT — apps/bestchef (Expo)</text>

      <g transform="translate(40,62)">
        <rect width="220" height="92" rx="10" fill="rgba(34,197,94,0.10)" stroke="rgba(34,197,94,0.5)"/>
        <text x="14" y="22" fill="#86EFAC" font-size="13" font-weight="700">Tabs</text>
        <text x="14" y="40" font-size="11" fill="rgba(255,255,255,0.7)">🏠 Home (feed + stats)</text>
        <text x="14" y="55" font-size="11" fill="rgba(255,255,255,0.7)">🍽 Dishes (browser)</text>
        <text x="14" y="70" font-size="11" fill="rgba(255,255,255,0.7)">🏆 Leaderboard</text>

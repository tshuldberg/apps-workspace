      </g>
      <g transform="translate(280,62)">
        <rect width="220" height="92" rx="10" fill="rgba(34,197,94,0.10)" stroke="rgba(34,197,94,0.5)"/>
        <text x="14" y="22" fill="#86EFAC" font-size="13" font-weight="700">Capture flows</text>
        <text x="14" y="40" font-size="11" fill="rgba(255,255,255,0.7)">📸 Receipt OCR</text>
        <text x="14" y="55" font-size="11" fill="rgba(255,255,255,0.7)">🥕 Grocery photo</text>
        <text x="14" y="70" font-size="11" fill="rgba(255,255,255,0.7)">📅 Expiration OCR</text>
        <text x="14" y="85" font-size="11" fill="rgba(255,255,255,0.7)">🎬 Video import</text>
      </g>
      <g transform="translate(520,62)">
        <rect width="220" height="92" rx="10" fill="rgba(34,197,94,0.10)" stroke="rgba(34,197,94,0.5)"/>
        <text x="14" y="22" fill="#86EFAC" font-size="13" font-weight="700">Social</text>
        <text x="14" y="40" font-size="11" fill="rgba(255,255,255,0.7)">💚 Submit recipe</text>
        <text x="14" y="55" font-size="11" fill="rgba(255,255,255,0.7)">🗳 Vote / comment</text>
        <text x="14" y="70" font-size="11" fill="rgba(255,255,255,0.7)">👨‍🍳 Chef profiles</text>
        <text x="14" y="85" font-size="11" fill="rgba(255,255,255,0.7)">⭐ Follow</text>
      </g>
      <g transform="translate(760,62)">
        <rect width="220" height="92" rx="10" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.2)"/>
        <text x="14" y="22" fill="rgba(255,255,255,0.85)" font-size="13" font-weight="700">Local cache (SQLite)</text>

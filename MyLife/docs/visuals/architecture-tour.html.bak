          <text x="14" y="18" fill="#D8C9FF" font-size="10" font-weight="700">SQLite-prefixed (local-first)</text>
          <text x="14" y="36">📚 books bk_  ·  💸 budget bg_  ·  🚗 car cr_  ·  🍽 dining dn_  ·  ⏱ fast ft_  ·  💬 forums fr_  ·  ✅ habits hb_  ·  ❤️ health hl_  ·  📓 journal  ·  ✉️ mail  ·  🛒 market mk_</text>
          <text x="14" y="52">💊 meds md_  ·  😊 mood  ·  📝 notes  ·  🥗 nutrition nu_  ·  🐾 pets  ·  📍 presence pr_  ·  🍳 recipes rc_  ·  📅 rsvp rv_  ·  ⭐ stars  ·  🧾 subs  ·  🌊 surf sf_  ·  🔤 words wd_  ·  💪 workouts wk_</text>
        </g>
      </g>

      <!-- Layer: shared packages -->
      <rect x="40" y="380" width="1200" height="84" rx="14" fill="url(#lg-data)" stroke="rgba(45,212,191,0.4)"/>
      <text x="60" y="406" fill="#9EEEDF" font-size="11" font-weight="700" letter-spacing="2">SHARED PACKAGES</text>
      <g font-size="11" fill="rgba(255,255,255,0.85)">
        <g transform="translate(60,418)"><rect width="170" height="38" rx="8" fill="rgba(45,212,191,0.08)" stroke="rgba(45,212,191,0.35)"/><text x="12" y="16" font-weight="600" fill="#9EEEDF">@mylife/db</text><text x="12" y="30" font-size="10" fill="rgba(255,255,255,0.6)">SQLite + migrations</text></g>
        <g transform="translate(244,418)"><rect width="170" height="38" rx="8" fill="rgba(45,212,191,0.08)" stroke="rgba(45,212,191,0.35)"/><text x="12" y="16" font-weight="600" fill="#9EEEDF">@mylife/sync</text><text x="12" y="30" font-size="10" fill="rgba(255,255,255,0.6)">Mesh CRDT engine</text></g>
        <g transform="translate(428,418)"><rect width="170" height="38" rx="8" fill="rgba(45,212,191,0.08)" stroke="rgba(45,212,191,0.35)"/><text x="12" y="16" font-weight="600" fill="#9EEEDF">@mylife/ui</text><text x="12" y="30" font-size="10" fill="rgba(255,255,255,0.6)">Tokens · components</text></g>
        <g transform="translate(612,418)"><rect width="170" height="38" rx="8" fill="rgba(45,212,191,0.08)" stroke="rgba(45,212,191,0.35)"/><text x="12" y="16" font-weight="600" fill="#9EEEDF">@mylife/auth</text><text x="12" y="30" font-size="10" fill="rgba(255,255,255,0.6)">Auth wrapper</text></g>
        <g transform="translate(796,418)"><rect width="170" height="38" rx="8" fill="rgba(45,212,191,0.08)" stroke="rgba(45,212,191,0.35)"/><text x="12" y="16" font-weight="600" fill="#9EEEDF">@mylife/subscription</text><text x="12" y="30" font-size="10" fill="rgba(255,255,255,0.6)">RevenueCat + Stripe</text></g>
        <g transform="translate(980,418)"><rect width="240" height="38" rx="8" fill="rgba(45,212,191,0.08)" stroke="rgba(45,212,191,0.35)"/><text x="12" y="16" font-weight="600" fill="#9EEEDF">@mylife/intelligence · social · migration</text></g>
      </g>

      <!-- Storage layer -->
      <rect x="40" y="484" width="1200" height="76" rx="14" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.1)"/>
      <text x="60" y="510" fill="rgba(255,255,255,0.6)" font-size="11" font-weight="700" letter-spacing="2">STORAGE TIERS</text>
      <g font-size="11" fill="rgba(255,255,255,0.85)">
        <g transform="translate(60,520)"><rect width="220" height="32" rx="8" fill="rgba(255,184,119,0.08)" stroke="rgba(255,184,119,0.35)"/><text x="12" y="20" fill="#FFD3A8" font-weight="600">SQLite (one file, prefixed)</text></g>
        <g transform="translate(294,520)"><rect width="220" height="32" rx="8" fill="rgba(167,139,250,0.08)" stroke="rgba(167,139,250,0.35)"/><text x="12" y="20" fill="#D8C9FF" font-weight="600">CRDT sidecar (11 tables)</text></g>
        <g transform="translate(528,520)"><rect width="220" height="32" rx="8" fill="rgba(45,212,191,0.08)" stroke="rgba(45,212,191,0.35)"/><text x="12" y="20" fill="#9EEEDF" font-weight="600">Supabase Postgres + RLS</text></g>
        <g transform="translate(762,520)"><rect width="220" height="32" rx="8" fill="rgba(34,197,94,0.08)" stroke="rgba(34,197,94,0.45)"/><text x="12" y="20" fill="#86EFAC" font-weight="600">Supabase Storage (media)</text></g>
        <g transform="translate(996,520)"><rect width="224" height="32" rx="8" fill="rgba(244,162,97,0.08)" stroke="rgba(244,162,97,0.35)"/><text x="12" y="20" fill="#F4C795" font-weight="600">Encrypted relay (ciphertext)</text></g>

        <rect width="240" height="92" rx="10" fill="rgba(255,255,255,0.04)" stroke="rgba(255,255,255,0.2)"/>
        <text x="14" y="22" fill="rgba(255,255,255,0.85)" font-size="13" font-weight="700">SDK clients</text>
        <text x="14" y="40" font-size="11" fill="rgba(255,255,255,0.6)">@supabase/supabase-js</text>
        <text x="14" y="55" font-size="11" fill="rgba(255,255,255,0.6)">expo-secure-store (sessions)</text>
        <text x="14" y="70" font-size="11" fill="rgba(255,255,255,0.6)">expo-image-picker · file-system</text>
        <text x="14" y="85" font-size="11" fill="rgba(255,255,255,0.6)">expo-av · gesture-handler</text>
      </g>

      <!-- Auth + Edge -->
      <rect x="20" y="190" width="1240" height="150" rx="14" fill="url(#bc-edge)" stroke="rgba(167,139,250,0.4)"/>
      <text x="40" y="216" fill="#D8C9FF" font-size="11" font-weight="700" letter-spacing="2">AUTH · EDGE FUNCTIONS · WORKERS</text>

      <g transform="translate(40,232)">
        <rect width="280" height="92" rx="10" fill="rgba(167,139,250,0.10)" stroke="rgba(167,139,250,0.5)"/>
        <text x="14" y="22" fill="#D8C9FF" font-size="13" font-weight="700">Supabase Auth</text>
        <text x="14" y="40" font-size="11" fill="rgba(255,255,255,0.7)">Email + magic-link · Apple · Google</text>
        <text x="14" y="55" font-size="11" fill="rgba(255,255,255,0.7)">Anonymous beta sessions (current)</text>
        <text x="14" y="70" font-size="11" fill="rgba(255,255,255,0.7)">Native deep-link callback</text>
        <text x="14" y="85" font-size="11" fill="rgba(255,255,255,0.7)">JWT carries app_metadata.role</text>
      </g>

      <g transform="translate(340,232)">
        <rect width="280" height="92" rx="10" fill="rgba(167,139,250,0.10)" stroke="rgba(167,139,250,0.5)"/>
        <text x="14" y="22" fill="#D8C9FF" font-size="13" font-weight="700">Edge Functions</text>
        <text x="14" y="40" font-size="11" fill="rgba(255,255,255,0.7)">moderation: media + comments</text>
        <text x="14" y="55" font-size="11" fill="rgba(255,255,255,0.7)">leaderboard-snapshot (cron)</text>
        <text x="14" y="70" font-size="11" fill="rgba(255,255,255,0.7)">delete-account-worker</text>
        <text x="14" y="85" font-size="11" fill="rgba(255,255,255,0.7)">nutrition / dish merge jobs</text>
      </g>

      <g transform="translate(640,232)">
        <rect width="280" height="92" rx="10" fill="rgba(167,139,250,0.10)" stroke="rgba(167,139,250,0.5)"/>
        <text x="14" y="22" fill="#D8C9FF" font-size="13" font-weight="700">Server RPCs</text>
        <text x="14" y="40" font-size="11" fill="rgba(255,255,255,0.7)">bc_submit_recipe / cast_vote</text>
        <text x="14" y="55" font-size="11" fill="rgba(255,255,255,0.7)">bc_post_comment_sanitized</text>
        <text x="14" y="70" font-size="11" fill="rgba(255,255,255,0.7)">bc_compute_dish_leaderboard</text>
        <text x="14" y="85" font-size="11" fill="rgba(255,255,255,0.7)">bc_apply_submission_alias</text>
      </g>

      <g transform="translate(940,232)">
        <rect width="300" height="92" rx="10" fill="rgba(244,162,97,0.10)" stroke="rgba(244,162,97,0.5)"/>
        <text x="14" y="22" fill="#F4C795" font-size="13" font-weight="700">External providers</text>
        <text x="14" y="40" font-size="11" fill="rgba(255,255,255,0.7)">OCR (receipts / expiration)</text>
        <text x="14" y="55" font-size="11" fill="rgba(255,255,255,0.7)">Vision (grocery photo)</text>
        <text x="14" y="70" font-size="11" fill="rgba(255,255,255,0.7)">Open Food Facts (nutrition)</text>
        <text x="14" y="85" font-size="11" fill="rgba(255,255,255,0.7)">RevenueCat · Stripe (later)</text>
      </g>

      <!-- Data layer -->
      <rect x="20" y="360" width="1240" height="270" rx="14" fill="url(#bc-data)" stroke="rgba(139,207,240,0.4)"/>
      <text x="40" y="386" fill="#BFE5F5" font-size="11" font-weight="700" letter-spacing="2">PERSISTENCE — Supabase Postgres · RLS · Storage</text>

      <!-- DB tables grouping -->
      <g transform="translate(40,400)">
        <rect width="380" height="220" rx="12" fill="rgba(139,207,240,0.07)" stroke="rgba(139,207,240,0.3)"/>
        <text x="14" y="20" fill="#BFE5F5" font-size="12" font-weight="700">Public catalog (read-mostly)</text>
        <g font-family="JetBrains Mono, monospace" font-size="11" fill="rgba(255,255,255,0.85)">
          <text x="14" y="44">bc_dishes</text>
          <text x="14" y="62">bc_dish_aliases</text>
          <text x="14" y="80">bc_recipe_snapshots</text>
          <text x="14" y="98">bc_submissions</text>
          <text x="14" y="116">bc_submission_aliases</text>
          <text x="14" y="134">bc_leaderboards</text>
          <text x="14" y="152">bc_dish_categories</text>
          <text x="14" y="170">bc_cuisines</text>
          <text x="14" y="188">bc_product_records (canonical food)</text>
          <text x="14" y="206">bc_product_contributions</text>
        </g>
      </g>

      <g transform="translate(440,400)">
        <rect width="380" height="220" rx="12" fill="rgba(167,139,250,0.07)" stroke="rgba(167,139,250,0.3)"/>
        <text x="14" y="20" fill="#D8C9FF" font-size="12" font-weight="700">Social + identity</text>
        <g font-family="JetBrains Mono, monospace" font-size="11" fill="rgba(255,255,255,0.85)">
          <text x="14" y="44">social_profiles (handle, avatar)</text>
          <text x="14" y="62">social_follows</text>
          <text x="14" y="80">social_posts</text>
          <text x="14" y="98">bc_comments (sanitized RPC)</text>
          <text x="14" y="116">bc_votes (write via RPC only)</text>
          <text x="14" y="134">bc_signature_dishes</text>
          <text x="14" y="152">bc_chef_badges</text>
          <text x="14" y="170">bc_account_lifecycle</text>
          <text x="14" y="188">bc_account_deletion_jobs</text>
          <text x="14" y="206">bc_creator_links</text>
        </g>
      </g>

      <g transform="translate(840,400)">
        <rect width="400" height="220" rx="12" fill="rgba(34,197,94,0.07)" stroke="rgba(34,197,94,0.4)"/>
        <text x="14" y="20" fill="#86EFAC" font-size="12" font-weight="700">Media · moderation · ops</text>
        <g font-family="JetBrains Mono, monospace" font-size="11" fill="rgba(255,255,255,0.85)">
          <text x="14" y="44">bc_media_assets (manifest)</text>
          <text x="14" y="62">bc_media_variants (renditions)</text>
          <text x="14" y="80">bc_moderation_queue</text>
          <text x="14" y="98">bc_moderation_decisions</text>
          <text x="14" y="116">bc_reports</text>
          <text x="14" y="134">bc_audit_log</text>
          <text x="14" y="152">bc_rate_limits</text>
          <text x="14" y="170">storage://bc-media/  (public, signed)</text>
          <text x="14" y="188">storage://bc-evidence/  (private)</text>
          <text x="14" y="206">storage://bc-deletion-archive/  (TTL)</text>
        </g>
      </g>

      <!-- Bottom bar: footer notes -->
      <rect x="20" y="650" width="1240" height="38" rx="8" fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.08)"/>
      <text x="40" y="675" fill="rgba(255,255,255,0.65)" font-size="11">RLS policies: <tspan fill="#86EFAC">public read</tspan> on catalogs · <tspan fill="#FFD3A8">owner-write</tspan> on profile/recipe-owned · <tspan fill="#A78BFA">RPC-only</tspan> on votes/comments · <tspan fill="#F4C795">admin-only</tspan> on moderation/audit</text>

      <!-- Connectors -->
      <g stroke="rgba(255,255,255,0.25)" stroke-width="1.5" fill="none" marker-end="url(#ar2)">
        <path d="M150,156 L150,190"/>
        <path d="M390,156 L390,190"/>
        <path d="M630,156 L630,190"/>
        <path d="M870,156 L870,190"/>
        <path d="M1100,156 L1100,190"/>
        <path d="M180,326 L180,360"/>
        <path d="M480,326 L480,360"/>
        <path d="M780,326 L780,360"/>
        <path d="M1080,326 L1080,360"/>
      </g>
    </svg>
    <div class="caption">BestChef public launch path: client → Auth/Edge → Postgres + Storage. Mutations on votes and comments go through SECURITY DEFINER RPCs so RLS never has to grant raw insert.</div>
  </div>

  <div class="grid three" style="margin-top:20px">
    <div class="card bestchef">
      <div class="kicker">Why server-backed</div>
      <h3>Public product, public threats</h3>
      <p>Leaderboards, comments, and follower graphs are by definition public state. They need authoritative ordering, server-side sanitization, abuse mitigation, and discoverable URLs. Mesh sync gives none of those guarantees.</p>
    </div>
    <div class="card bestchef">
      <div class="kicker">Why local SQLite still matters</div>
      <h3>Offline kitchen, optimistic UI</h3>
      <p>Pantry, grocery lists, saved recipes, drafts, receipt review — these stay snappy and offline-capable in expo-sqlite. The app never blocks on the network for kitchen actions. Public submissions then upload when online.</p>
    </div>
    <div class="card bestchef">
      <div class="kicker">Why CRDT is off the launch path</div>
      <h3>Convergence ≠ correctness</h3>
      <p>An attacker on the mesh can mint synthetic votes that all peers will dutifully merge. For an adversarial public surface, the server is the policeman. We keep <code>@mylife/sync</code> available for private features, but votes/comments hit RPC endpoints only.</p>
    </div>
  </div>
</section>

<!-- ============================================================ -->
<!-- BESTCHEF DATABASE -->
<!-- ============================================================ -->
<section id="bestchef-db">
  <h2><span class="num">05</span>BestChef Database — Two Halves</h2>
  <p class="sub">BestChef has two databases by design. The <strong>local SQLite half</strong> (<code>rc_*</code> + kitchen <code>rc_*</code> tables — schema v17) is the private kitchen. The <strong>cloud Postgres half</strong> (<code>bc_*</code> + <code>social_*</code> tables) is the public catalog and social graph. Both halves talk through explicit, sanitized boundaries.</p>

  <div class="erd-wrap">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <strong style="font-size:13px;letter-spacing:0.06em;color:var(--mylife)">LOCAL · SQLite · device only</strong>
      <span style="font-size:11px;color:var(--text-3);font-family:'JetBrains Mono',monospace">expo-sqlite · single file · prefix rc_</span>
    </div>
    <div class="erd">
      <div class="tbl local" data-tip="Saved private recipes the user wrote or imported. Source of truth lives on device.">
        <header><span class="name">rc_recipes</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id <span class="type">TEXT PK</span></li>
          <li>title <span class="type">TEXT</span></li>
          <li>servings <span class="type">INTEGER</span></li>
          <li>prep_time_mins <span class="type">INTEGER</span></li>
          <li>cook_time_mins <span class="type">INTEGER</span></li>
          <li>difficulty <span class="type">TEXT</span></li>
          <li>image_uri <span class="type">TEXT</span></li>
          <li>is_favorite <span class="type">INTEGER</span></li>
          <li>rating <span class="type">0..5</span></li>
          <li>notes · created_at · updated_at</li>
        </ul>
      </div>
      <div class="tbl local" data-tip="Per-recipe ingredient rows. FK back to rc_recipes. Quantity stored as text to preserve user input.">
        <header><span class="name">rc_ingredients</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id <span class="type">TEXT PK</span></li>
          <li class="fk">recipe_id <span class="type">FK rc_recipes</span></li>
          <li>name · quantity · unit</li>
          <li>sort_order <span class="type">INTEGER</span></li>
        </ul>
      </div>
      <div class="tbl local" data-tip="Recipe steps with optional timer.">
        <header><span class="name">rc_steps</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id <span class="type">TEXT PK</span></li>
          <li class="fk">recipe_id <span class="type">FK</span></li>
          <li>step_number · instruction</li>
          <li>timer_minutes <span class="type">INTEGER?</span></li>
        </ul>
      </div>
      <div class="tbl local" data-tip="Pantry inventory with batch/lot tracking introduced in schema v11+. Drives use-next prompts.">
        <header><span class="name">rc_pantry_items</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">canonical_food_id <span class="type">FK</span></li>
          <li>quantity · unit</li>
          <li>opened_at · expires_at</li>
          <li>source (receipt|photo|manual)</li>
        </ul>
      </div>
      <div class="tbl local" data-tip="Per-batch lot inside a pantry item. Use-next ranking sorts by expiry.">
        <header><span class="name">rc_pantry_batches</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">item_id <span class="type">FK rc_pantry_items</span></li>
          <li>batch_qty · unit</li>
          <li>added_at · expires_at</li>
          <li>provenance (receipt_id|photo_id)</li>
        </ul>
      </div>
      <div class="tbl local" data-tip="One row per receipt scan. Raw OCR is stripped before any sync.">
        <header><span class="name">rc_receipts</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id</li>
          <li>captured_at · provider</li>
          <li>status (pending|reviewed|imported)</li>
          <li>raw_ocr_blob <span class="type">stripped pre-sync</span></li>
        </ul>
      </div>
      <div class="tbl local" data-tip="Receipt line candidates awaiting confirmation, with optional provider-enriched nutrition.">
        <header><span class="name">rc_receipt_lines</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">receipt_id</li>
          <li>raw_text · matched_food_id?</li>
          <li>quantity · unit · price</li>
          <li>nutrition_candidate_id?</li>
        </ul>
      </div>
      <div class="tbl local" data-tip="Photos of groceries with optional crop/region evidence; per-candidate confirmation creates pantry batches.">
        <header><span class="name">rc_grocery_photos</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id</li>
          <li>image_uri · captured_at</li>
          <li>crop_region_json?</li>
          <li>status</li>
        </ul>
      </div>
      <div class="tbl local" data-tip="Multiple grocery lists per user, with active/archive status and metadata.">
        <header><span class="name">rc_grocery_lists</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id</li>
          <li>name · status (active|archived)</li>
          <li>created_at · updated_at</li>
        </ul>
      </div>
      <div class="tbl local" data-tip="Items in a grocery list. Driven by recipe Grocery flag, manual add, or pantry low-water.">
        <header><span class="name">rc_grocery_items</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">list_id</li>
          <li>name · quantity · unit</li>
          <li>checked · source_recipe_id?</li>
        </ul>
      </div>
      <div class="tbl local" data-tip="Canonical food identity rows. Resolver populates from local cache → server cache → providers.">
        <header><span class="name">rc_canonical_foods</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id</li>
          <li>name · brand · gtin?</li>
          <li>nutrition_source</li>
          <li>provenance_json</li>
        </ul>
      </div>
      <div class="tbl local" data-tip="Reusable user-corrected unit conversions. Persisted so 'a pinch of salt' resolves the same next time.">
        <header><span class="name">rc_unit_conversions</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id</li>
          <li>from_unit · to_unit · ratio</li>
          <li>scope (food_id?|global)</li>
          <li>corrected_by_user</li>
        </ul>
      </div>
      <div class="tbl local" data-tip="Weekly meal plan rows. Unique per (week,day,slot).">
        <header><span class="name">rc_meal_plans / rc_meal_plan_items</span><span class="scope">device_local</span></header>
        <ul>
          <li class="pk">id</li>
          <li>week_start_date</li>
          <li class="fk">recipe_id</li>
          <li>day_of_week · meal_slot · servings</li>
        </ul>
      </div>
    </div>

    <hr class="hr" />

    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:14px">
      <strong style="font-size:13px;letter-spacing:0.06em;color:var(--bestchef)">CLOUD · Supabase Postgres · public</strong>
      <span style="font-size:11px;color:var(--text-3);font-family:'JetBrains Mono',monospace">migrations/20260424000005_add_bestchef_core_hub.sql · prefix bc_</span>
    </div>
    <div class="erd">
      <div class="tbl cloud" data-tip="Canonical dish catalog. Aliases let the same dish (e.g. 'pho', 'phở') merge into one entry.">
        <header><span class="name">bc_dishes</span><span class="scope">public</span></header>
        <ul>
          <li class="pk">id <span class="type">UUID PK</span></li>
          <li>name · slug · native_name</li>
          <li>category · cuisine · region</li>
          <li>alias_count · submission_count</li>
          <li>status (active|pending|merged)</li>
          <li class="fk">proposed_by → social_profiles</li>
          <li class="fk">merged_into_dish_id</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="Localized name aliases for fuzzy search and merging.">
        <header><span class="name">bc_dish_aliases</span><span class="scope">public</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">dish_id</li>
          <li>alias · locale</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="Server snapshot of a private recipe a chef chose to publish. Original local recipe id is preserved for round-trip.">
        <header><span class="name">bc_recipe_snapshots</span><span class="scope">public</span></header>
        <ul>
          <li class="pk">id</li>
          <li>original_local_recipe_id</li>
          <li class="fk">profile_id → social_profiles</li>
          <li>title · description · servings</li>
          <li>ingredients_json (jsonb)</li>
          <li>steps_json (jsonb)</li>
          <li>tags · nutrition_json</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="A submission of a recipe to a dish leaderboard. One submission can be voted on, commented on, and ranked.">
        <header><span class="name">bc_submissions</span><span class="scope">public</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">dish_id · profile_id</li>
          <li class="fk">recipe_snapshot_id</li>
          <li>title · status · score</li>
          <li>created_at</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="Maps demo/local submission ids to hosted submission ids so beta builds can vote and comment from TestFlight.">
        <header><span class="name">bc_submission_aliases</span><span class="scope">public</span></header>
        <ul>
          <li class="pk">id</li>
          <li>local_submission_id (text)</li>
          <li class="fk">submission_id</li>
        </ul>
      </div>
      <div class="tbl shared" data-tip="Profile row keyed to auth.uid(). Owns submissions, votes, comments, follows.">
        <header><span class="name">social_profiles</span><span class="scope">user-owned</span></header>
        <ul>
          <li class="pk">id <span class="type">= auth.uid()</span></li>
          <li>handle · display_name</li>
          <li>avatar_url</li>
          <li>bio · created_at</li>
        </ul>
      </div>
      <div class="tbl shared" data-tip="Follow graph. Read-public, write-owner.">
        <header><span class="name">social_follows</span><span class="scope">user-owned</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">follower_id · followee_id</li>
          <li>created_at</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="Vote on a submission. Insertion is RPC-only so we can enforce one-vote-per-user-per-dish, role gates, and rate limits.">
        <header><span class="name">bc_votes</span><span class="scope">RPC-only write</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">submission_id · profile_id</li>
          <li>tier (gold|silver|bronze|like)</li>
          <li>created_at</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="Comments. Server sanitizes via bc_post_comment_sanitized RPC before insert. Moderation queue picks up flagged ones.">
        <header><span class="name">bc_comments</span><span class="scope">RPC-only write</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">submission_id · profile_id</li>
          <li>body · sanitized_body</li>
          <li>status</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="Storage manifest. Real bytes live in Supabase Storage; this table tracks owner, status, moderation, content hash, and dimensions.">
        <header><span class="name">bc_media_assets</span><span class="scope">public manifest</span></header>
        <ul>
          <li class="pk">id</li>
          <li>owner_kind · owner_id</li>
          <li>media_kind (image|video|recipe_bundle)</li>
          <li>storage_bucket · storage_key</li>
          <li>upload_status · moderation_status</li>
          <li>visibility · content_hash</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="Per-asset transcodes / renditions (thumb, hero, video qualities).">
        <header><span class="name">bc_media_variants</span><span class="scope">public</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">asset_id</li>
          <li>variant (thumb|hero|hls|preview)</li>
          <li>storage_key · bytes</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="Pre-rendered top-N rankings per dish + window. Refreshed by leaderboard-snapshot Edge Function.">
        <header><span class="name">bc_leaderboards</span><span class="scope">public · cron</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">dish_id</li>
          <li>window (day|week|all)</li>
          <li>rankings_json</li>
          <li>computed_at</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="Server-canonical food/product cache. Backs the local rc_canonical_foods resolver fallback.">
        <header><span class="name">bc_product_records</span><span class="scope">public canonical</span></header>
        <ul>
          <li class="pk">id</li>
          <li>name · brand · gtin?</li>
          <li>nutrition_json</li>
          <li>source · privacy_state</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="User-contributed product data with workflow states and recursive privacy checks before public visibility.">
        <header><span class="name">bc_product_contributions</span><span class="scope">workflow</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">product_record_id · profile_id</li>
          <li>state (draft|review|approved|rejected)</li>
          <li>diff_json · evidence_keys</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="Account lifecycle audit log added in 20260426 migration (created/linked/recovered/deleted). Drives /settings account UI and runbook.">
        <header><span class="name">bc_account_lifecycle</span><span class="scope">audit</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">profile_id</li>
          <li>event (created|linked|recovered|deleted)</li>
          <li>device · ip · created_at</li>
        </ul>
      </div>
      <div class="tbl cloud" data-tip="Pending account deletions. service-role worker wipes profile, owned content, media bytes, then archives encrypted record for legal TTL.">
        <header><span class="name">bc_account_deletion_jobs</span><span class="scope">service-role</span></header>
        <ul>
          <li class="pk">id</li>
          <li class="fk">profile_id</li>
          <li>state (queued|wiping|archived|done|failed)</li>
          <li>scheduled_for · finished_at</li>
        </ul>
      </div>
    </div>
  </div>

  <div class="insight">
    <div class="label">★ Database design notes</div>
    <ul>
      <li><strong>Two prefixes, two trust zones.</strong> <code>rc_*</code> = local kitchen (private). <code>bc_*</code> = cloud public. Crossing the boundary requires explicit publication (recipe_snapshots) or sanitization (RPCs).</li>
      <li><strong>Submission aliases bridge demo and prod.</strong> <code>bc_submission_aliases</code> lets the beta build's local/demo content map to a server submission so cross-anonymous votes still land correctly.</li>
      <li><strong>Media manifest, not media.</strong> <code>bc_media_assets</code> tracks <em>where</em> bytes live and <em>what state</em> they're in (uploaded, moderated, visibility). Bytes ride Supabase Storage; the table is the index.</li>
      <li><strong>Privacy on contributions is recursive.</strong> A contribution can include a draft that references a draft — the publish check walks the graph and refuses to surface anything still flagged private.</li>
    </ul>
  </div>
</section>

<!-- ============================================================ -->
<!-- BESTCHEF FLOWS -->
<!-- ============================================================ -->
<section id="bestchef-flows">
  <h2><span class="num">06</span>User Workflows</h2>
  <p class="sub">The five flows below are the spine of BestChef. Each runs through a different mix of local SQLite, server RPCs, Storage, and Edge workers. Hover any step.</p>

  <h3 style="font-size:16px;color:var(--bestchef);margin:20px 0 12px;letter-spacing:0.04em">A · Submit a recipe to a dish leaderboard</h3>
  <div class="flow">
    <div class="step" data-tip="Local edit, no server call yet."><span class="num">1</span><h4>Draft locally</h4><p>User writes the recipe in the standalone app. Saved into <code>rc_recipes</code> + <code>rc_ingredients</code> + <code>rc_steps</code>.</p><span class="tag">SQLite · device_local</span></div>
    <div class="step" data-tip="The user picks (or proposes) a dish. New dish proposals flow through bc_dishes status=pending."><span class="num">2</span><h4>Pick or propose dish</h4><p>App searches <code>bc_dishes</code> + <code>bc_dish_aliases</code>. New dishes are queued as <code>status=pending</code>.</p><span class="tag">Postgres · public</span></div>
    <div class="step" data-tip="Photo or video uploaded straight to Supabase Storage with a server-issued signed URL."><span class="num">3</span><h4>Upload media</h4><p>Image/video is hashed locally, uploaded to <code>bc-media</code> bucket, and recorded in <code>bc_media_assets</code> as <code>upload_status=uploaded</code>.</p><span class="tag">Storage + manifest</span></div>
    <div class="step" data-tip="Edge function scans media + text. Approved → public. Quarantined → review queue."><span class="num">4</span><h4>Moderation</h4><p>Edge function runs vision + text moderation. Output writes to <code>bc_moderation_decisions</code> and flips media to <code>moderation_status=approved</code>.</p><span class="tag">Edge function</span></div>
    <div class="step" data-tip="Snapshot is created server-side via RPC. Original local id stays so the user can edit and re-publish."><span class="num">5</span><h4>Publish snapshot</h4><p>RPC creates <code>bc_recipe_snapshots</code> + <code>bc_submissions</code>. App refreshes the dish leaderboard view.</p><span class="tag">RPC · published</span></div>
  </div>

  <h3 style="font-size:16px;color:var(--bestchef);margin:32px 0 12px;letter-spacing:0.04em">B · Vote and comment</h3>
  <div class="flow">
    <div class="step"><span class="num">1</span><h4>Open submission</h4><p>App fetches <code>bc_submissions</code> with joined profile + media manifest + comment count.</p><span class="tag">Postgres read</span></div>
    <div class="step"><span class="num">2</span><h4>Cast vote</h4><p>Client calls <code>bc_cast_vote(submission_id, tier)</code> RPC. Function enforces one-vote-per-user-per-dish, role gates, and rate limits.</p><span class="tag">RPC · SECURITY DEFINER</span></div>
    <div class="step"><span class="num">3</span><h4>Score recompute</h4><p>Trigger updates <code>bc_submissions.score</code>; nightly cron refreshes <code>bc_leaderboards</code> snapshots.</p><span class="tag">Trigger + cron</span></div>
    <div class="step"><span class="num">4</span><h4>Comment</h4><p>App calls <code>bc_post_comment_sanitized(submission_id, body)</code>. Server strips disallowed content, stores raw + sanitized.</p><span class="tag">Sanitized RPC</span></div>
    <div class="step"><span class="num">5</span><h4>Realtime</h4><p>Subscribed clients see new votes/comments via Supabase Realtime channels filtered by RLS.</p><span class="tag">Realtime</span></div>
  </div>

  <h3 style="font-size:16px;color:var(--bestchef);margin:32px 0 12px;letter-spacing:0.04em">C · Receipt → Pantry (local-only)</h3>
  <div class="flow">
    <div class="step"><span class="num">1</span><h4>Capture</h4><p>User photos a grocery receipt. <code>rc_receipts</code> row is created; image saved locally.</p><span class="tag">SQLite</span></div>
    <div class="step"><span class="num">2</span><h4>OCR</h4><p>Configured provider returns lines. Raw OCR is stripped before any sync (privacy cap).</p><span class="tag">Provider · privacy</span></div>
    <div class="step"><span class="num">3</span><h4>Match candidates</h4><p>Each line resolves against <code>rc_canonical_foods</code> → server <code>bc_product_records</code> → providers, with confidence scores.</p><span class="tag">Resolver ladder</span></div>
    <div class="step"><span class="num">4</span><h4>Review &amp; correct</h4><p>User confirms, edits, or merges line items. Corrections persist into <code>rc_unit_conversions</code> for reuse.</p><span class="tag">Confirmation-gated</span></div>
    <div class="step"><span class="num">5</span><h4>Pantry batches</h4><p>Confirmed lines write <code>rc_pantry_batches</code> with provenance. Use-next prompts now know expiry &amp; quantity.</p><span class="tag">SQLite · use-next</span></div>
  </div>

  <h3 style="font-size:16px;color:var(--bestchef);margin:32px 0 12px;letter-spacing:0.04em">D · Account creation, link, delete</h3>
  <div class="flow">
    <div class="step"><span class="num">1</span><h4>Anonymous beta</h4><p>App opens with an anonymous Supabase session. Local kitchen works immediately — no email needed.</p><span class="tag">Auth anonymous</span></div>
    <div class="step"><span class="num">2</span><h4>Link identity</h4><p>User links email/Apple/Google in Settings. <code>social_profiles</code> upserts; <code>bc_account_lifecycle</code> logs <code>linked</code>.</p><span class="tag">Auth link</span></div>
    <div class="step"><span class="num">3</span><h4>Recovery</h4><p>Magic-link via deep-link URL. Native callback handler in app/_layout swaps the session.</p><span class="tag">Deep link</span></div>
    <div class="step"><span class="num">4</span><h4>Delete account</h4><p>Settings action enqueues <code>bc_account_deletion_jobs</code>. Local SQLite is wiped immediately on the device.</p><span class="tag">Local wipe + queue</span></div>
    <div class="step"><span class="num">5</span><h4>Worker</h4><p>service-role Edge worker wipes content, removes media bytes, archives an encrypted audit record for the legal TTL window.</p><span class="tag">Service role</span></div>
  </div>

  <h3 style="font-size:16px;color:var(--bestchef);margin:32px 0 12px;letter-spacing:0.04em">E · Leaderboard read</h3>
  <div class="flow">
    <div class="step"><span class="num">1</span><h4>Tab open</h4><p>App opens Leaderboard tab. Top-level fetch hits cached <code>bc_leaderboards</code> rows by window.</p><span class="tag">Cache hit</span></div>
    <div class="step"><span class="num">2</span><h4>Hydrate top-N</h4><p>For each ranked submission id, app loads joined submission + profile + media variant in one round trip.</p><span class="tag">Joined read</span></div>
    <div class="step"><span class="num">3</span><h4>Filter</h4><p>User filters by category/cuisine/region; app re-queries <code>bc_dishes</code> indexes.</p><span class="tag">Indexed</span></div>
    <div class="step"><span class="num">4</span><h4>Realtime delta</h4><p>If a fresh vote arrives, the Realtime channel patches the score in place without a full reload.</p><span class="tag">Realtime</span></div>
    <div class="step"><span class="num">5</span><h4>Open submission</h4><p>Tap drills into the submission. Detail view fetches comments + variants on demand.</p><span class="tag">Lazy</span></div>
  </div>
</section>

<!-- ============================================================ -->
<!-- FEATURE MAP -->
<!-- ============================================================ -->
<section id="features">
  <h2><span class="num">07</span>Feature Map</h2>
  <p class="sub">BestChef's surface area divided into <strong>Public Social</strong> (server-backed) and <strong>Private Kitchen</strong> (local-first). Both are wired in the same app shell; the boundary is the network.</p>

  <div class="grid two">
    <div class="card bestchef">
      <div class="kicker">Public Social · server-backed</div>
      <h3>Compete · discover · follow</h3>
      <ul style="padding-left:18px;color:var(--text-2);font-size:13px;line-height:1.7;margin:8px 0 0">
        <li><strong>Dish browser:</strong> categories, cuisines, regions, search by alias.</li>
        <li><strong>Submissions:</strong> publish a snapshot of a private recipe to a dish.</li>
        <li><strong>Voting tiers:</strong> gold / silver / bronze / like, RPC-gated.</li>
        <li><strong>Comments:</strong> server-sanitized, moderation-queued.</li>
        <li><strong>Leaderboards:</strong> per-dish top-N for day / week / all-time.</li>
        <li><strong>Chef profiles:</strong> stats, signature dishes, badges, follow.</li>
        <li><strong>Creator program:</strong> creator links, future revenue share.</li>
        <li><strong>Feed:</strong> followed-chef new submissions and signature updates.</li>
      </ul>
    </div>

    <div class="card mylife">
      <div class="kicker">Private Kitchen · local-first</div>
      <h3>Plan · cook · waste less</h3>
      <ul style="padding-left:18px;color:var(--text-2);font-size:13px;line-height:1.7;margin:8px 0 0">
        <li><strong>Saved recipes:</strong> private recipes, full CRUD on device.</li>
        <li><strong>Grocery lists:</strong> multiple lists, active/archive states.</li>
        <li><strong>Pantry:</strong> per-item batches with expiry &amp; provenance.</li>
        <li><strong>Receipt OCR:</strong> import groceries, confirm before pantry write.</li>
        <li><strong>Grocery photo:</strong> recognize items, optional crop evidence.</li>
        <li><strong>Expiration OCR:</strong> photo a date, confirm, set expiry.</li>
        <li><strong>Use-next prompts:</strong> recipes that match what's about to expire.</li>
        <li><strong>Universal nutrition:</strong> resolve once, reuse across recipes/dishes.</li>
        <li><strong>Meal planner:</strong> week × day × slot grid.</li>
      </ul>
    </div>
  </div>

  <div class="grid three" style="margin-top:18px">
    <div class="card">
      <div class="kicker">Crossover · publish</div>
      <h3>Saved → Snapshot</h3>
      <p>A private recipe stays in <code>rc_recipes</code> until the user explicitly publishes. Publication writes a sanitized snapshot to <code>bc_recipe_snapshots</code> and creates a <code>bc_submissions</code> entry. The original local recipe is never overwritten.</p>
    </div>
    <div class="card">
      <div class="kicker">Crossover · resolve</div>
      <h3>Local food ↔ canonical record</h3>
      <p>Nutrition resolver pulls from server <code>bc_product_records</code> when the local cache misses, then writes back into <code>rc_canonical_foods</code> with provenance. Contributions can flow upstream as <code>bc_product_contributions</code>.</p>
    </div>
    <div class="card warn">
      <div class="kicker">Crossover · privacy cap</div>
      <h3>Receipt raw OCR is stripped</h3>
      <p>Receipt blobs and grocery candidate text never leave the device. The privacy-preserving sync policy strips raw OCR/candidates before any cross-device sync. Only confirmed pantry batches and matched canonical food references replicate.</p>
    </div>
  </div>
</section>


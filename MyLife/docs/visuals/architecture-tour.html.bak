      <text x="60" y="58" fill="#FFD3A8" font-size="11" font-weight="700" letter-spacing="2">HOST APPS</text>
      <g class="node" transform="translate(60,72)">
        <rect width="240" height="44" rx="10" fill="rgba(255,184,119,0.10)" stroke="rgba(255,184,119,0.5)"/>
        <text x="16" y="20" fill="#FFE3C0" font-size="13" font-weight="600">apps/mobile</text>

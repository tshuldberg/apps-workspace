{
  "expo": {
    "name": "BestChef",
    "slug": "bestchef",
    "owner": "trebaybay",
    "version": "1.0.0",
    "scheme": "bestchef",
    "platforms": [
      "ios"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#131318"
    },
    "ios": {
      "bundleIdentifier": "com.bestchef.bestchef",
      "supportsTablet": true,
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "BestChef uses the camera so you can take photos and videos of dishes, recipe steps, and your chef profile.",
        "NSMicrophoneUsageDescription": "BestChef uses the microphone when you record dish or recipe videos with audio.",
        "NSPhotoLibraryUsageDescription": "BestChef uses your photo library so you can choose photos and videos for dish submissions and your chef profile.",
        "NSLocationWhenInUseUsageDescription": "BestChef uses your location to auto-detect your city for your chef profile and local food context."
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp", "NSPrivacyAccessedAPITypeReasons": ["C617.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace", "NSPrivacyAccessedAPITypeReasons": ["E174.1"] },
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime", "NSPrivacyAccessedAPITypeReasons": ["35F9.1"] }
        ],
        "NSPrivacyCollectedDataTypes": [
          { "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeEmailAddress", "NSPrivacyCollectedDataTypeLinked": true, "NSPrivacyCollectedDataTypeTracking": false, "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"] },
          { "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypePhotosorVideos", "NSPrivacyCollectedDataTypeLinked": true, "NSPrivacyCollectedDataTypeTracking": false, "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"] },
          { "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeOtherUserContent", "NSPrivacyCollectedDataTypeLinked": true, "NSPrivacyCollectedDataTypeTracking": false, "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"] },
          { "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeCoarseLocation", "NSPrivacyCollectedDataTypeLinked": true, "NSPrivacyCollectedDataTypeTracking": false, "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"] },
          { "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeUserID", "NSPrivacyCollectedDataTypeLinked": true, "NSPrivacyCollectedDataTypeTracking": false, "NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"] }
        ]
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BestChef uses the camera to scan grocery barcodes so you can add pantry items quickly."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "es",
              "fr",
              "de",
              "it",
              "pt-BR",
              "pt-PT",
              "nl",
              "sv",
              "pl",
              "tr",
              "id",
              "vi",
              "hi",
              "th",
              "ja",
              "ko",
              "zh-Hans",
              "zh-Hant",
              "ar",
              "he"
            ],
            "android": [
              "en",
              "es",
              "fr",
              "de",
              "it",
              "pt-BR",
              "pt-PT",
              "nl",
              "sv",
              "pl",
              "tr",
              "id",
              "vi",
              "hi",
              "th",
              "ja",
              "ko",
              "zh-Hans",
              "zh-Hant",
              "ar",
              "he"
            ]
          }
        }
      ],
      "./plugins/withSecurityHardening",
      "./plugins/withDataProtection",
      [
        "@sentry/react-native/expo",
        {
          "organization": "SENTRY_ORG",
          "project": "bestchef",
          "url": "https://sentry.io/",
          "disableAutoUpload": true
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6e5f293e-c48a-41db-9838-08846e817488"
      },
      "router": {}
    },
    "updates": {
      "enabled": false
    }
  }
}

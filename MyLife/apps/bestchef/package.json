    "seed:cheftom": "node scripts/seed-cheftom-content.mjs",
    "seed:job-config": "node scripts/seed-bc-job-config.mjs",
    "check:health": "node scripts/check-bestchef-health.mjs",
    "test:uiux": "vitest run --passWithNoTests \"app/(root)/__tests__/uiux-interaction-contract.test.ts\"",
    "eas-build-pre-install": "node scripts/assert-eas-production-env.mjs",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",

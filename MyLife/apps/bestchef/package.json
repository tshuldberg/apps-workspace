{
  "name": "@mylife/bestchef-app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "build": "expo export --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",

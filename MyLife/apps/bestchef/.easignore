# BestChef EAS archive ignore.
# EAS may archive from the app root or the monorepo root, so keep both
# app-relative and workspace-relative forms for generated/heavy paths.

# App-local generated output
dist/
.expo/
ios/
ios/Pods/
ios/build/
android/
node_modules/
*.tsbuildinfo

# Workspace-relative generated output
apps/bestchef/dist/
apps/bestchef/.expo/
apps/bestchef/ios/
apps/bestchef/ios/Pods/
apps/bestchef/ios/build/
apps/bestchef/android/
apps/bestchef/node_modules/
apps/bestchef/*.tsbuildinfo

# Monorepo-only surfaces not needed for the standalone BestChef build
.claude/
.gstack/
.turbo/
.context/
.kiro/
.playwright-mcp/
.git/
.github/
docs/
archive/
artifacts/
deploy/
output/
plans/
test/
supabase/
ai-customization/
apps/mobile/
apps/web/

# Tests and generated reports
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
coverage/
test-results/
*.pnpm-debug.log

# Large media and generated documents
*.png
*.jpg
*.jpeg
*.mp4
*.mov
*.pdf

# Secrets
.env
.env.*
*.key
*.pem
*.p8
*.p12
*.mobileprovision
GoogleService-Info.plist
google-services.json
*.keystore
*.jks
.npmrc
secrets/
credentials/

# Keep the app icon asset (overrides the *.png exclude above) so EAS embeds it
!apps/bestchef/assets/icon.png
!assets/icon.png

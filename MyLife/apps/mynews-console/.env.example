# MyNews moderator console environment contract.
# ALL values are server-side only. There are intentionally NO NEXT_PUBLIC_*
# variables in this app: the service-role key and even the anon key never
# reach a client bundle.

# Supabase project the console moderates (staging or prod).
MYNEWS_CONSOLE_SUPABASE_URL=
MYNEWS_CONSOLE_SUPABASE_ANON_KEY=
# Service role key. Grants nw_moderate_* execute (enforcement RPCs).
MYNEWS_CONSOLE_SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated moderator email allowlist. Empty list = nobody can sign in
# (fail closed). Matching is case-insensitive.
MYNEWS_CONSOLE_MODERATOR_EMAILS=

# Public origin of THIS console deployment, used for magic-link redirects.
# Must be listed in Supabase Auth -> URL Configuration -> Redirect URLs.
MYNEWS_CONSOLE_ORIGIN=http://localhost:3106

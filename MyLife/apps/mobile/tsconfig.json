{
  "extends": "@mylife/typescript-config/react.json",
  "compilerOptions": {
    "strict": true,
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "react",
      "react-dom"
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    // Mirror Metro's platform-specific file resolution for type-checking.
    // Metro picks `<file>.native.ts` before `<file>.ts` on mobile, so a
    // package can ship a web-safe default `./ui/index.ts` and a full RN
    // `./ui/index.native.ts` without breaking tsc on the mobile app.
    // See modules/budget/src/ui/index.native.ts for the pattern.
    "moduleSuffixes": [".native", ""],
    // Resolve the `"react-native"` subpath condition in package.json
    // `exports` blocks (e.g. modules/budget/package.json's conditional
    // `./ui` export). Metro applies this at runtime; without this line
    // tsc falls back to the `"default"` entry.
    "customConditions": ["react-native"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/__tests__/**",
    "test/**",
    "vitest.config.ts",
    "vitest.debug.config.ts"
  ]
}

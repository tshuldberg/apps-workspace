# EAS Build ignore - exclude non-essential files from upload
# The monorepo upload includes everything from the workspace root

# Large skill directories (509MB+)
.claude/skills/
.claude/agents/
.claude/memory/

# Documentation and plans
docs/
.kiro/

# Archives and standalone apps
archive/

# Git and CI
.git/
.github/

# Other apps (web not needed for mobile build)
# Note: can't exclude apps/web because EAS needs the workspace structure

# IDE and editor
.vscode/
.idea/

# Test artifacts
artifacts/
coverage/

# Large generated files
*.pnpm-debug.log

# Screenshots and media
*.png
*.jpg
*.mp4
*.mov

# Standalone submodules (not needed for mobile build)
MyBooks/
MyBudget/
MySurf/
MyWorkouts/
MyFast/
MyMail/
MyHomes/

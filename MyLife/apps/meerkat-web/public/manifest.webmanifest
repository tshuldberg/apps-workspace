{
  "name": "Meerkat",
  "short_name": "Meerkat",
  "description": "A private social space for communities, messages, and files.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#111816",
  "theme_color": "#0E7C66",
  "icons": [
    { "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "audio/*",
            "video/*",
            "application/pdf",
            "text/*",
            "application/octet-stream"
          ]
        }
      ]
    }
  }
}

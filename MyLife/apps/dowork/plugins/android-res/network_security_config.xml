<?xml version="1.0" encoding="utf-8"?>
<!--
  Default deny cleartext traffic app-wide.
  All network requests must go over TLS (HTTPS/WSS).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

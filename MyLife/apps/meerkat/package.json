{
  "name": "@mylife/meerkat-app",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "eas-build-pre-install": "node scripts/check-build-env.mjs",
    "build": "expo export --platform android --platform ios",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint app app.config.ts scripts --ext .ts,.tsx,.mjs",
    "test": "vitest run --passWithNoTests",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.6",
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@maplibre/maplibre-react-native": "^10.2.0",
    "@mylife/billing-config": "workspace:*",
    "@mylife/db": "workspace:*",
    "@mylife/entitlements": "workspace:*",
    "@mylife/meerkat-call-native": "workspace:*",
    "@mylife/meerkat-icloud-storage": "workspace:*",
    "@mylife/meerkat-native-transport": "workspace:*",
    "@mylife/meerkat-canvas": "workspace:*",
    "@mylife/meerkat-layout": "workspace:*",
    "@mylife/meerkat-theme": "workspace:*",
    "@mylife/sync": "workspace:*",
    "@mylife/ui": "workspace:*",
    "expo": "~54.0.37",
    "expo-auth-session": "~7.0.11",
    "expo-background-task": "~1.0.10",
    "expo-battery": "~10.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-image-manipulator": "~14.0.7",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-share-intent": "5.1.1",
    "expo-sharing": "^14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-task-manager": "~14.0.9",
    "expo-video": "~3.0.16",
    "lucide-react-native": "^0.469.0",
    "pako": "^1.0.11",
    "react": "19.1.0",
    "react-native": "~0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-purchases": "10.2.2",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "~15.12.1",
    "react-native-tcp-socket": "^6.3.0",
    "@livekit/react-native": "2.11.1",
    "@livekit/react-native-webrtc": "144.1.1",
    "livekit-client": "2.20.1",
    "react-native-webview": "13.15.0",
    "react-native-zeroconf": "^0.13.8",
    "tweetnacl-util": "^0.15.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@config-plugins/react-native-webrtc": "^13.0.0",
    "@livekit/react-native-expo-plugin": "1.0.2",
    "@mylife/typescript-config": "workspace:*",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react": "~19.1.10",
    "better-sqlite3": "^11.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-tcp-socket",
          "@livekit/react-native-webrtc",
          "@livekit/react-native"
        ]
      }
    }
  }

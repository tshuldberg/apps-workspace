{
  "expo": {
    "name": "Meerkat",
    "slug": "meerkat",
    "owner": "trebaybay",
    "version": "1.0.0",
    "scheme": "meerkat",
    "icon": "./assets/icon.png",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "imageWidth": 200,
      "backgroundColor": "#F6F4EF"
    },
    "newArchEnabled": false,
    "ios": {
      "bundleIdentifier": "com.mylife.meerkat",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Meerkat syncs your encrypted data directly with your own paired devices on this network. Nothing is readable in transit.",
        "NSBonjourServices": [
          "_mylife-sync._tcp"
        ],
        "UIBackgroundModes": [
          "fetch",
          "processing",
          "remote-notification",
          "audio"
        ],
        "BGTaskSchedulerPermittedIdentifiers": [
          "meerkat-background-sync"
        ],
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.mylife.meerkat",
      "allowBackup": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.WAKE_LOCK"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Meerkat uses your camera for video calls and to scan QR codes."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c662e59e-1950-4b9e-ae0e-262bc3bbfdf1"
      }
    }
  }
}

{
  // MyNews-scoped edge-function typecheck (plan 48 WP11 CI).
  //
  // The parent `tsconfig.json` includes EVERY function in this directory, and it
  // is currently red on files no MyNews work package owns (bestchef-vision
  // tests). It is also wired to no gate, so that breakage is invisible. Gating
  // MyNews CI on it would either inherit an unrelated failure or invite someone
  // to loosen compiler options until it passed.
  //
  // This config changes NOTHING about the compiler: it extends the parent
  // verbatim and only narrows `include` to the MyNews surface (the functions,
  // the `_shared/mynews-*` modules they import, and the `_shared/__tests__`
  // suites that cover those modules). Every import reachable from those files
  // was checked: the MyNews functions and their shared modules import only
  // `_shared/mynews-*`, `modules/mynews/src/**`, `@mylife/sync`, `vitest`, and
  // `test/vitest/function-quality`. No non-MyNews `_shared` file is reachable,
  // so none is listed.
  //
  // Do not add `skipLibCheck`, `noImplicitAny: false`, or any other relaxation
  // here. If this config goes red, the MyNews code is wrong.
  "extends": "./tsconfig.json",
  "include": [
    "mynews-*/**/*.ts",
    "_shared/mynews-*.ts",
    "_shared/__tests__/mynews-*.ts"
  ]
}

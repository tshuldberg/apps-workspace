{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vitest/globals"],
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    // Function TESTS reach into the module packages for signing helpers and
    // keypair generation (the handlers themselves never do: they are Deno and
    // import only from _shared). The repo root has no node_modules/@mylife, so
    // without these mappings tsc cannot resolve them here even though vitest
    // does, which left real type errors in test files invisible.
    "paths": {
      "@mylife/sync": ["../../packages/sync/src/index.ts"],
      "@mylife/mynews": ["../../modules/mynews/src/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}

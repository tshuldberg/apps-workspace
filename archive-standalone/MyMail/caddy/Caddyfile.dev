# =============================================================================
# MyMail - Caddy Development Configuration
# No TLS, localhost access for debugging
# =============================================================================

{
	auto_https off
	admin :2019
}

# Webmail on localhost (no TLS)
:80 {
	encode gzip

	root * /var/www/html
	php_fastcgi roundcube:9000

	file_server
	log
}

# Admin UI
:8082 {
	encode gzip
	reverse_proxy admin-ui:3000
	log
}

# Stalwart JMAP API
:8083 {
	reverse_proxy stalwart:8080
	log
}

# =============================================================================
# MyMail - Caddy Reverse Proxy Configuration (Production)
# Auto-HTTPS via Let's Encrypt, security headers, gzip compression
# =============================================================================

# Global options
{
	email {$ADMIN_EMAIL:admin@{$DOMAIN}}
	acme_ca https://acme-v02.api.letsencrypt.org/directory
}

# ─── Webmail (Roundcube) ────────────────────────────────────────────────────
{$HOSTNAME} {
	encode gzip zstd

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'self';"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# PHP-FPM via fastcgi to Roundcube container
	root * /var/www/html
	php_fastcgi roundcube:9000

	file_server
	log {
		output file /data/logs/webmail-access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# ─── Admin Dashboard ───────────────────────────────────────────────────────
admin.{$DOMAIN} {
	encode gzip zstd

	# Security headers
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none';"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	reverse_proxy admin-ui:3000

	log {
		output file /data/logs/admin-access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

# ─── Stalwart JMAP API (internal, proxied for autodiscover) ────────────────
jmap.{$DOMAIN} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}

	reverse_proxy stalwart:8080

	log {
		output file /data/logs/jmap-access.log {
			roll_size 10mb
			roll_keep 5
		}
	}
}

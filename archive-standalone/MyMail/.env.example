###############################################################################
# MyMail - Environment Configuration
# Copy to .env and fill in your values: cp .env.example .env
###############################################################################

# ─── Domain Configuration ───────────────────────────────────────────────
# Your base domain (e.g., example.com)
DOMAIN=example.com

# Mail server hostname - must have A record and PTR record pointing to SERVER_IP
HOSTNAME=mail.example.com

# Public IP address of this server (used for DNS record validation)
SERVER_IP=0.0.0.0

# ─── Admin Account ──────────────────────────────────────────────────────
# Initial admin email address (created during first run)
ADMIN_EMAIL=admin@example.com

# Admin password (change this! setup.sh will generate one if left as default)
ADMIN_PASSWORD=changeme

# ─── Outbound Relay (Amazon SES / any SMTP relay) ──────────────────────
# Enable relay for outbound mail (recommended for new IPs to avoid blacklists)
RELAY_ENABLED=true

# SMTP relay server hostname
RELAY_HOST=email-smtp.us-east-1.amazonaws.com

# SMTP relay port (587 for STARTTLS, 465 for SMTPS)
RELAY_PORT=587

# SMTP relay credentials
RELAY_USER=
RELAY_PASSWORD=

# Use STARTTLS (true) or implicit TLS (false)
RELAY_STARTTLS=true

# ─── Backup (Backblaze B2 / S3-compatible storage) ─────────────────────
# Enable automated backups
BACKUP_ENABLED=true

# S3-compatible endpoint (Backblaze B2, AWS S3, MinIO, etc.)
BACKUP_S3_ENDPOINT=s3.us-west-000.backblazeb2.com

# Bucket name for backups
BACKUP_S3_BUCKET=mymail-backups

# S3 access key and secret
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# Backup schedule in cron format (default: 2:00 AM daily)
BACKUP_SCHEDULE=0 2 * * *

# Number of days to retain backups
BACKUP_RETENTION=30

# ─── Restic Backup Encryption ──────────────────────────────────────────
# Password for encrypting backups (auto-generated by setup.sh if empty)
RESTIC_PASSWORD=
